FLASK_APP=app.py
FLASK_ENV=development  # Set to 'production' in production environment
FLASK_DEBUG=True       # Set to 'False' in production environment
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Security settings
SECRET_KEY=sahil
JWT_SECRET_KEY=sahil
JWT_ACCESS_TOKEN_EXPIRES=86400  # 24 hours in seconds

# Database configuration
DATABASE_DRIVER=mysql
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_HOST=localhost  # Use 'db' when running with Docker Compose
DATABASE_PORT=3306
DATABASE_NAME=malware_detector
DATABASE_URL=${DATABASE_DRIVER}://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# Model configuration
MODEL_DIR=models
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16MB max upload size